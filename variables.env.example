# Settings for fews4all.sh. Copy to variables.env and edit; variables.env is
# gitignored, because it will eventually hold API keys.
#
#     cp variables.env.example variables.env

# Where this checkout lives. Left commented, the script uses its own directory,
# which is almost always what you want. Uncomment only to run against a checkout
# somewhere else. Do not set it to "" — other settings below are built from it.
#FEWS_ROOT="/Users/you/FEWS4All"

# Conda. CONDA_SH is the script that teaches your shell the `conda` command —
# a cron job gets none of your .zshrc, so it has to be sourced explicitly.
CONDA_SH="$HOME/miniforge3/etc/profile.d/conda.sh"
CONDA_ENV="hydroinformatics"

# Seconds to wait before doing anything. A scheduled run that starts at 06:00
# can be cancelled with Ctrl-C during this window if you are watching and do not
# want it to go. Set to 0 to start immediately.
SLEEP_LENGTH=30

# Where the run log goes. One file per UTC day, appended to.
#
# Beside the project, so it is somewhere you can actually see — ~/Library/Logs is
# the macOS convention and Console.app reads it, but Finder hides it, which makes
# it a poor home for something you want to glance at. `logs/` is gitignored.
LOG_DIR="$FEWS_ROOT/logs"

# Optional. A Slack (or similar) incoming-webhook URL; if set, a failure posts
# there. Leave empty and failures only go to the log.
WEBHOOK_ERROR_URL=""
