Other/
# Where the Claude desktop app drops files delivered from a chat session. It is
# recreated at the repo root every time one arrives, so this is a standing rule
# rather than something to clean up by hand. Nothing in it is a source: if a
# delivered file matters, move it into the folder it belongs to.
Claude outputs/
# NOTE: a bare `.gitignore` rule used to sit here. It matched EVERY nested
# .gitignore in the repo, so docs/.gitignore was silently never committed and
# a fresh clone ignored nothing it said. This file survived only because it was
# already tracked, and git does not ignore a tracked file. Removed 2026-10-29.
public/
# The data tree: raw downloads and published releases, dated. Gigabytes a day,
# and every byte of it either re-fetchable or regenerated by a run.
fews4all_data

# Retired by the move to fews4all_data; still ignored so an un-migrated
# machine does not try to commit one.
backend/input
backend/output

# backend/static holds the builders and what they built. The builders are code
# and are tracked; the two folders below are not.
#
#   tables/  big derived tables, parquet. Every one is rebuildable by the
#            build_*.py script sitting beside it, from source data that lives
#            outside the repo — reproducible rather than authored, and hundreds
#            of megabytes that would be a fresh binary blob in every diff.
#   tiles/   the PMTiles archives, several GB.
#
# ref/ is deliberately NOT here. Those files are small, hand-maintained or
# recorded by a decision someone made — the patch list of cells the automated
# sources miss, the record of what the blackout box is hiding — and losing them
# would mean losing the decision, not just a rebuild.
backend/static/tables/
backend/static/tiles/

# Local settings for fews4all.sh; may hold API keys.
variables.env
.fews4all.lock
